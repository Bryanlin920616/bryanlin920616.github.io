---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const upcoming = [
  {
    status: 'Planned · Spring 2026',
    title: 'Graduate School Applications',
    lang: '中文',
    description:
      '2026 Fall CS 碩士申請的完整紀錄 — 從選校、SOP 到面試，寫給之後要申請的人看。',
  },
  {
    status: 'Ongoing',
    title: 'Engineering Notes',
    lang: '中 / EN',
    description:
      'System design 拆解、工具鏈探索、debugging 故事 — 學到的東西整理成文字比較記得住。',
  },
];
---
<BaseLayout title={`Blog — ${profile.name}`} description="Writing on engineering, study, and the things Bryan is paying attention to.">
  <div class="max-w-5xl mx-auto px-6 py-16">

    <h1 class="font-display text-4xl font-bold text-warm-fg dark:text-dark-fg mb-3">Blog</h1>
    <div class="w-8 h-0.5 bg-warm-accent dark:bg-dark-accent mb-10"></div>

    <div class="max-w-2xl">

    {posts.length === 0 ? (
      <>
        <p class="text-base text-warm-muted dark:text-dark-muted leading-relaxed mb-2">
          Writing on engineering, study, and the things I'm paying attention to.
        </p>
        <p class="text-base text-warm-muted dark:text-dark-muted leading-relaxed">
          第一篇預計 2026 年春發佈。
        </p>

        <section class="mt-16 border-t border-warm-border dark:border-dark-border">
          {upcoming.map(item => (
            <article class="py-8 border-b border-warm-border dark:border-dark-border">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-[11px] font-semibold tracking-[0.18em] uppercase text-warm-accent dark:text-dark-accent">
                  {item.status}
                </span>
                <span class="text-[11px] text-warm-subtle dark:text-dark-muted">
                  {item.lang}
                </span>
              </div>
              <h2 class="font-display text-xl font-semibold text-warm-fg dark:text-dark-fg mb-2 leading-snug">
                {item.title}
              </h2>
              <p class="text-sm text-warm-muted dark:text-dark-muted leading-relaxed">
                {item.description}
              </p>
            </article>
          ))}
        </section>

        <p class="mt-10 text-sm text-warm-muted dark:text-dark-muted leading-relaxed">
          Want to know when I publish? Follow on{' '}
          <a href={profile.github} target="_blank" rel="noopener noreferrer" class="text-warm-fg dark:text-dark-fg underline decoration-warm-accent dark:decoration-dark-accent underline-offset-4 hover:text-warm-accent dark:hover:text-dark-accent transition-colors">
            GitHub
          </a>
          {' '}or{' '}
          <a href={`mailto:${profile.email}`} class="text-warm-fg dark:text-dark-fg underline decoration-warm-accent dark:decoration-dark-accent underline-offset-4 hover:text-warm-accent dark:hover:text-dark-accent transition-colors">
            drop a line
          </a>.
        </p>
      </>
    ) : (
      <ul class="space-y-6">
        {posts.map(post => (
          <li>
            <a href={`/blog/${post.slug}`} class="group block">
              <time class="text-xs text-warm-subtle dark:text-dark-muted">
                {post.data.pubDate.toLocaleDateString('zh-TW')}
              </time>
              <h2 class="text-lg font-semibold text-warm-fg dark:text-dark-fg group-hover:text-warm-accent dark:group-hover:text-dark-accent transition-colors mt-1">
                {post.data.title}
              </h2>
              <p class="text-sm text-warm-muted dark:text-dark-muted mt-1 leading-relaxed">
                {post.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )}

    </div><!-- /max-w-2xl -->
  </div>
</BaseLayout>
