---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';
import { sitePath } from '../../utils/urls';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<BaseLayout title={`Blog — ${profile.name}`} description="生活、工作和學習路上的紀錄。">
  <div class="max-w-5xl mx-auto px-6 py-16">

    <h1 class="font-display text-4xl font-bold text-warm-fg dark:text-dark-fg mb-3">Blog</h1>
    <div class="w-8 h-0.5 bg-warm-accent dark:bg-dark-accent mb-10"></div>

    <div class="max-w-2xl">

      <ul class="space-y-6">
        {posts.map(post => (
          <li>
            <a href={sitePath(`/blog/${post.slug}`)} class="group block">
              <time class="text-xs text-warm-subtle dark:text-dark-muted">
                {post.data.pubDate.toLocaleDateString('zh-TW')}
              </time>
              <h2 class="text-lg font-semibold text-warm-fg dark:text-dark-fg group-hover:text-warm-accent dark:group-hover:text-dark-accent transition-colors mt-1">
                {post.data.title}
              </h2>
              <p class="text-sm text-warm-muted dark:text-dark-muted mt-1 leading-relaxed">
                {post.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>

    </div><!-- /max-w-2xl -->
  </div>
</BaseLayout>
