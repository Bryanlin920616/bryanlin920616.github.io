---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---
<BaseLayout title="Bryan Lin — Blog" description="Bryan 的個人網站，寫一些生活、工作和學習路上的紀錄。">
  <Hero />

  <section class="max-w-5xl mx-auto px-6 py-12 sm:py-14" data-fade>
    <div class="max-w-3xl border-t border-warm-border dark:border-dark-border pt-10">
      <div class="flex items-baseline justify-between gap-6 mb-7">
        <h2 class="text-sm font-semibold text-warm-fg dark:text-dark-fg">
          最近寫的
        </h2>
        <a
          href="/blog"
          class="text-sm text-warm-muted dark:text-dark-muted hover:text-warm-fg dark:hover:text-dark-fg transition-colors shrink-0"
        >
          所有文章 →
        </a>
      </div>

      {posts.length > 0 ? (
        <ul class="divide-y divide-warm-border dark:divide-dark-border">
          {posts.map(post => (
            <li class="py-6 first:pt-0">
              <a href={`/blog/${post.slug}`} class="group grid gap-2 sm:grid-cols-[7rem_1fr] sm:gap-6">
                <time class="text-sm text-warm-subtle dark:text-dark-muted pt-1">
                  {post.data.pubDate.toLocaleDateString('zh-TW', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                  })}
                </time>
                <div>
                  <h3 class="text-xl font-semibold text-warm-fg dark:text-dark-fg group-hover:text-warm-accent dark:group-hover:text-dark-accent transition-colors leading-snug">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-warm-muted dark:text-dark-muted mt-2 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-base text-warm-muted dark:text-dark-muted leading-relaxed">
          文章還在整理中。之後會放一些生活、工作和學習路上的紀錄。
        </p>
      )}
    </div>
  </section>
</BaseLayout>
