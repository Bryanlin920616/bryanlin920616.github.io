---
import { profile } from '../data/profile';
---
<section class="max-w-5xl mx-auto px-6 pt-20 pb-16">

  {profile.openToWork && (
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-warm-accent dark:text-dark-accent mb-10 animate-fade-up">
      <span class="w-1.5 h-1.5 rounded-full bg-warm-accent dark:bg-dark-accent"></span>
      Available for new roles
    </span>
  )}

  <h1
    class="font-display font-extrabold tracking-tight leading-[0.9] text-warm-fg dark:text-dark-fg animate-fade-up delay-100 mb-6"
    style="font-size: clamp(3.25rem, 9vw, 5.75rem)"
  >
    {profile.name}
  </h1>

  <p class="text-xs font-semibold tracking-[0.18em] uppercase text-warm-subtle dark:text-dark-muted animate-fade-up delay-200 mb-8">
    {profile.role}&ensp;·&ensp;{profile.location}
  </p>

  <p class="text-base text-warm-muted dark:text-dark-muted leading-relaxed animate-fade-up delay-300" style="max-width: 42ch">
    {profile.tagline}
  </p>

  <div class="flex items-center gap-7 mt-10 animate-fade-up delay-400">
    <a
      href="/projects"
      class="px-5 py-2.5 bg-warm-fg dark:bg-dark-fg text-warm-bg dark:text-dark-bg text-sm font-semibold rounded-lg hover:opacity-80 transition-opacity"
    >
      View Projects →
    </a>
    <a
      href="/about"
      class="text-sm font-medium text-warm-muted dark:text-dark-muted hover:text-warm-fg dark:hover:text-dark-fg transition-colors"
    >
      About Me →
    </a>
  </div>

</section>
