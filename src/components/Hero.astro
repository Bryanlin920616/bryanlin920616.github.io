---
import { profile } from '../data/profile';
---
<section class="max-w-5xl mx-auto px-6 pt-20 pb-16">
  {profile.openToWork && (
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-warm-accent/10 dark:bg-dark-accent/10 text-warm-accent dark:text-dark-accent text-xs font-medium mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-warm-accent dark:bg-dark-accent"></span>
      Open to Work
    </div>
  )}
  <h1 class="text-5xl sm:text-6xl font-extrabold text-warm-fg dark:text-dark-fg leading-tight mb-4">
    {profile.name}
  </h1>
  <p class="text-xl text-warm-muted dark:text-dark-muted font-medium mb-4">{profile.role}</p>
  <p class="text-base text-warm-muted dark:text-dark-muted leading-relaxed max-w-lg mb-8">
    {profile.tagline}
  </p>
  <div class="flex gap-3 flex-wrap">
    <a href="/work" class="px-5 py-2.5 bg-warm-fg dark:bg-dark-fg text-warm-bg dark:text-dark-bg text-sm font-medium rounded-lg hover:opacity-90 transition-opacity">
      View Projects →
    </a>
    <a href="/about" class="px-5 py-2.5 border border-warm-border dark:border-dark-border text-warm-fg dark:text-dark-fg text-sm font-medium rounded-lg hover:border-warm-accent dark:hover:border-dark-accent transition-colors">
      About Me
    </a>
  </div>
</section>
