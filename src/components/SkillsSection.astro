---
const skillGroups = [
  { label: 'Languages',  skills: ['Go', 'Python', 'C/C++', 'JavaScript', 'SQL', 'Swift'] },
  { label: 'Frameworks', skills: ['Gin', 'FastAPI', 'gRPC', 'RESTful API'] },
  { label: 'Databases',  skills: ['PostgreSQL', 'MongoDB', 'Manticore Search'] },
  { label: 'DevOps',     skills: ['Docker', 'Git', 'GitHub Actions', 'Azure'] },
];
---
<section
  class="max-w-5xl mx-auto px-6 py-10 border-t border-warm-border dark:border-dark-border"
  data-fade
>
  <p class="text-xs font-semibold tracking-[0.18em] uppercase text-warm-subtle dark:text-dark-muted mb-6">
    Tech Stack
  </p>

  <div class="flex flex-col gap-3">
    {skillGroups.map(group => {
      const [primary, ...rest] = group.skills;
      return (
        <div class="flex items-baseline gap-4 sm:gap-6">
          <span class="text-xs text-warm-subtle dark:text-dark-muted w-20 shrink-0 pt-px">
            {group.label}
          </span>
          <p class="text-sm leading-relaxed">
            <span class="font-semibold text-warm-fg dark:text-dark-fg">{primary}</span>
            {rest.length > 0 && <span class="text-warm-muted dark:text-dark-muted"> · {rest.join(' · ')}</span>}
          </p>
        </div>
      );
    })}
  </div>
</section>
