---
import TechPill from './TechPill.astro';
import { profile } from '../data/profile';
---
<section class="max-w-5xl mx-auto px-6 py-10 border-t border-warm-border dark:border-dark-border">
  <p class="text-xs font-medium tracking-widest text-warm-subtle dark:text-dark-muted uppercase mb-4">Tech Stack</p>
  <div class="flex flex-wrap gap-2">
    {profile.skills.map(skill => <TechPill label={skill} />)}
  </div>
</section>
