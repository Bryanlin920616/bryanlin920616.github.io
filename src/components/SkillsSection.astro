---
const skillGroups = [
  { label: 'Languages',  skills: ['Go', 'Python', 'C/C++', 'JavaScript', 'SQL', 'Swift'] },
  { label: 'Frameworks', skills: ['Gin', 'FastAPI', 'gRPC', 'RESTful API'] },
  { label: 'Databases',  skills: ['PostgreSQL', 'MongoDB', 'Manticore Search'] },
  { label: 'DevOps',     skills: ['Docker', 'Git', 'GitHub Actions', 'Azure'] },
];
---
<section
  class="max-w-5xl mx-auto px-6 py-12 border-t border-warm-border dark:border-dark-border"
  data-fade
>
  <p class="text-xs font-semibold tracking-[0.18em] uppercase text-warm-subtle dark:text-dark-muted mb-8">
    Tech Stack
  </p>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-8">
    {skillGroups.map(group => (
      <div>
        <p class="text-xs font-medium text-warm-subtle dark:text-dark-muted mb-3 tracking-wide">
          {group.label}
        </p>
        <ul class="flex flex-col gap-2">
          {group.skills.map(skill => (
            <li class="text-sm text-warm-fg dark:text-dark-fg">{skill}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
