---
import TechPill from './TechPill.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---
<article class="group bg-warm-surface-2 dark:bg-dark-surface-2 rounded-xl p-6 flex flex-col gap-4 hover:bg-warm-surface dark:hover:bg-dark-surface transition-colors duration-200 cursor-default">

  <div class="flex-1 flex flex-col gap-2">
    <h3 class="text-base font-semibold text-warm-fg dark:text-dark-fg group-hover:text-warm-accent dark:group-hover:text-dark-accent transition-colors leading-snug">
      {project.title}
    </h3>
    <p class="text-sm text-warm-muted dark:text-dark-muted leading-relaxed">
      {project.description}
    </p>
  </div>

  <div class="flex flex-wrap gap-1.5">
    {project.tags.map(tag => <TechPill label={tag} />)}
  </div>

  <div class="flex gap-5 pt-1">
    {project.github && (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium text-warm-subtle dark:text-dark-muted hover:text-warm-accent dark:hover:text-dark-accent transition-colors"
      >
        GitHub ↗
      </a>
    )}
    {project.demo && (
      <a
        href={project.demo}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium text-warm-subtle dark:text-dark-muted hover:text-warm-accent dark:hover:text-dark-accent transition-colors"
      >
        Demo ↗
      </a>
    )}
  </div>

</article>
