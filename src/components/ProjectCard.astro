---
import TechPill from './TechPill.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---
<article class="bg-warm-surface dark:bg-dark-surface border border-warm-border dark:border-dark-border rounded-xl p-5 flex flex-col gap-3 hover:border-warm-accent/40 dark:hover:border-dark-accent/40 transition-colors">
  <div>
    <div class="flex flex-wrap gap-2 mb-2">
      {project.tags.map(tag => <TechPill label={tag} />)}
    </div>
    <h3 class="text-base font-semibold text-warm-fg dark:text-dark-fg">{project.title}</h3>
    <p class="text-sm text-warm-muted dark:text-dark-muted leading-relaxed mt-1">{project.description}</p>
  </div>
  <div class="flex gap-4 mt-auto">
    {project.github && (
      <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-xs text-warm-muted dark:text-dark-muted hover:text-warm-accent dark:hover:text-dark-accent transition-colors">
        GitHub ↗
      </a>
    )}
    {project.demo && (
      <a href={project.demo} target="_blank" rel="noopener noreferrer" class="text-xs text-warm-muted dark:text-dark-muted hover:text-warm-accent dark:hover:text-dark-accent transition-colors">
        Demo ↗
      </a>
    )}
  </div>
</article>
