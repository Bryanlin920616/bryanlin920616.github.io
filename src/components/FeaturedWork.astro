---
import ProjectCard from './ProjectCard.astro';
import FeaturedProjectCard from './FeaturedProjectCard.astro';
import { featuredProjects } from '../data/projects';

const [hero, ...rest] = featuredProjects;
---
<section
  class="max-w-5xl mx-auto px-6 py-14"
  data-fade
>
  <div class="flex items-baseline justify-between mb-8">
    <p class="text-xs font-semibold tracking-[0.18em] uppercase text-warm-subtle dark:text-dark-muted">
      Featured Work
    </p>
    <a
      href="/projects"
      class="text-xs font-medium text-warm-muted dark:text-dark-muted hover:text-warm-fg dark:hover:text-dark-fg transition-colors"
    >
      View all →
    </a>
  </div>

  {hero && <FeaturedProjectCard project={hero} />}

  {rest.length > 0 && (
    <div class="mt-6 grid gap-3 md:grid-cols-2">
      {rest.map(project => <ProjectCard project={project} />)}
    </div>
  )}
</section>
