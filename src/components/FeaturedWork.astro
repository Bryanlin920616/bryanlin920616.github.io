---
import ProjectCard from './ProjectCard.astro';
import { featuredProjects } from '../data/projects';
---
<section class="max-w-5xl mx-auto px-6 py-12">
  <div class="flex items-center justify-between mb-6">
    <p class="text-xs font-medium tracking-widest text-warm-subtle dark:text-dark-muted uppercase">Featured Work</p>
    <a href="/work" class="text-sm text-warm-muted dark:text-dark-muted hover:text-warm-accent dark:hover:text-dark-accent transition-colors">
      View all →
    </a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {featuredProjects.map(project => <ProjectCard project={project} />)}
  </div>
</section>
